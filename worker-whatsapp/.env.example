# Redis do Laravel. O prefixo é o mesmo que o Laravel põe nas chaves (REDIS_PREFIX ou slug(APP_NAME)-database-).
REDIS_URL=redis://redis:6379/0
REDIS_PREFIX=oficina-database-

# Callback de status para a API (mesmo segredo que WHATSAPP_WORKER_SECRET do backend).
API_URL=http://app:8000
WHATSAPP_WORKER_SECRET=

# Meta (Cloud API). Token do usuário de sistema do Prumo; nunca commitar.
META_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0

# Servidor do webhook da Meta (GET/POST /webhook) e /health.
PORT=3001
# Intervalo mínimo entre envios do mesmo número remetente.
SEND_MIN_INTERVAL_MS=100

# Sentry: vazio = desligado.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
