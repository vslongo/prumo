# Laravel API used by Next.js rewrites (set before production builds).
API_URL=http://localhost:8000

# Copie para .env.local (ignorado pelo git). Vazio = Sentry desligado (dev).
# Dado pessoal é filtrado em src/shared/lib/sentry.ts.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_RELEASE=

# Suporte: WhatsApp do Prumo, só dígitos com DDI (ex.: 5547999990000). Vazio = o link de suporte some.
NEXT_PUBLIC_SUPPORT_WHATSAPP=
